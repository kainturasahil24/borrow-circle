# ---------------------------------------------------------------------------
# API environment. Copy to server/.env:
#   cp server/.env.example server/.env   (from the repo root on bash)
#
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local docker compose database (PostGIS enabled).
DATABASE_URL=postgresql://borrow:borrow_dev_password@localhost:5432/borrow_circle?schema=public

# Comma-separated browser/app origins allowed by CORS.
# 5173 = admin (Vite), 8081/19006 = Expo dev server / web.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# --- Auth -------------------------------------------------------------------
# Both must be >= 32 chars and different from each other.
JWT_ISSUER=borrow-circle
JWT_ACCESS_SECRET=dev_access_secret_change_me_32chars_min
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_32chars_min
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Phase 2: OTP + KYC -----------------------------------------------------
# Peppers must be >= 32 chars and different from each other and from JWT secrets.
# Changing OTP_PEPPER invalidates every in-flight OTP.
OTP_PEPPER=dev_otp_pepper_change_me_32chars_min
IDENTITY_HASH_PEPPER=dev_identity_pepper_change_me_32chars_min
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_REQUESTS_PER_HOUR=5

# Mock providers are the only ones wired in Phase 2.
SMS_PROVIDER=mock
KYC_PROVIDER=mock

# Local convenience: return the OTP as `devCode` in the API response.
# Ignored when NODE_ENV=production. Set to false to test the real delivery path.
EXPOSE_DEV_OTP=true

# Phones promoted to ADMIN on first sign-in. Comma-separated, E.164.
# Local default: any code for this number is returned as devCode above.
ADMIN_PHONES=+919999999999

# ---------------------------------------------------------------------------
# Reserved for later phases — leave blank until the phase that uses them.
# ---------------------------------------------------------------------------
# Field-level encryption key (base64, 32 bytes) for KYC/PII — Phase 14
# FIELD_ENCRYPTION_KEY=
# MSG91 / SMS partner credentials — Phase 14 (SMS_PROVIDER stays "mock" for now)
# MSG91_AUTH_KEY=
# Storage (Cloudinary or S3) — Phase 3
# STORAGE_PROVIDER=local
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# FIREBASE_PROJECT_ID=
# SENTRY_DSN=
